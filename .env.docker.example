# Local development only. Replace both database passwords for your own machine.
DB_PASSWORD=sportshub-local-db-only
DB_ROOT_PASSWORD=sportshub-local-root-only
APP_ENV=development
APP_URL=http://localhost:8080
# Leave blank in local Docker mode to generate a persistent key in the private app_data volume.
# For production, generate/provide a private base64 32-byte key; never use demo mode.
APP_KEY=
# Explicitly enable disposable demo sports data/accounts in local development.
DEMO_MODE=1
